<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="spa.controller.GerantUsersController"
      spacing="20"
      alignment="CENTER"
      prefWidth="850"
      prefHeight="600"
      style="-fx-background-color:#f4f6f9;">

    <!-- TITRE -->
    <Label text="👤 Gestion des Utilisateurs"
           style="-fx-font-size:22px;
                  -fx-font-weight:bold;
                  -fx-text-fill:#2c3e50;" />

    <!-- FORMULAIRE -->
    <GridPane hgap="15" vgap="12"
              alignment="CENTER"
              style="-fx-background-color:white;
                     -fx-padding:20;
                     -fx-background-radius:10;
                     -fx-border-radius:10;
                     -fx-border-color:#dcdcdc;">

        <Label text="Nom :" style="-fx-font-weight:bold;"
               GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="nomField"
                   promptText="Nom"
                   GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="CIN :" style="-fx-font-weight:bold;"
               GridPane.rowIndex="0" GridPane.columnIndex="2"/>
        <TextField fx:id="cinField"
                   promptText="CIN"
                   GridPane.rowIndex="0" GridPane.columnIndex="3"/>

        <Label text="Téléphone :" style="-fx-font-weight:bold;"
               GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="telField"
                   promptText="Téléphone"
                   GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Email :" style="-fx-font-weight:bold;"
               GridPane.rowIndex="1" GridPane.columnIndex="2"/>
        <TextField fx:id="emailField"
                   promptText="Email"
                   GridPane.rowIndex="1" GridPane.columnIndex="3"/>

        <Label text="Mot de passe :" style="-fx-font-weight:bold;"
               GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <PasswordField fx:id="passwordField"
                       promptText="Mot de passe"
                       GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Rôle :" style="-fx-font-weight:bold;"
               GridPane.rowIndex="2" GridPane.columnIndex="2"/>
        <ComboBox fx:id="roleBox"
                  promptText="Choisir rôle"
                  GridPane.rowIndex="2"
                  GridPane.columnIndex="3"/>

    </GridPane>

    <!-- BOUTONS CRUD -->
    <HBox spacing="15" alignment="CENTER">

        <Button text="➕ Ajouter"
                onAction="#ajouter"
                prefWidth="130"
                style="-fx-background-color:#27ae60;
                       -fx-text-fill:white;
                       -fx-font-size:14px;
                       -fx-background-radius:8;" />

        <Button text="🔄 Afficher"
                onAction="#afficher"
                prefWidth="130"
                style="-fx-background-color:#3498db;
                       -fx-text-fill:white;
                       -fx-font-size:14px;
                       -fx-background-radius:8;" />

        <Button text="✏ Modifier"
                onAction="#modifier"
                prefWidth="130"
                style="-fx-background-color:#f39c12;
                       -fx-text-fill:white;
                       -fx-font-size:14px;
                       -fx-background-radius:8;" />

        <Button text="🗑 Supprimer"
                onAction="#supprimer"
                prefWidth="130"
                style="-fx-background-color:#e74c3c;
                       -fx-text-fill:white;
                       -fx-font-size:14px;
                       -fx-background-radius:8;" />

    </HBox>

    <!-- TABLE -->
    <TableView fx:id="tableUser"
               prefHeight="300"
               prefWidth="780"
               style="-fx-background-color:white;
                      -fx-background-radius:10;
                      -fx-border-radius:10;
                      -fx-border-color:#dcdcdc;">

        <columns>
            <TableColumn fx:id="colNom" text="Nom" prefWidth="150"/>
            <TableColumn fx:id="colCin" text="CIN" prefWidth="150"/>
            <TableColumn fx:id="colTel" text="Téléphone" prefWidth="150"/>
            <TableColumn fx:id="colEmail" text="Email" prefWidth="200"/>
            <TableColumn fx:id="colRole" text="Rôle" prefWidth="130"/>
        </columns>

    </TableView>

    <!-- RETOUR -->
    <Button text="⬅ Retour"
            onAction="#back"
            prefWidth="200"
            style="-fx-background-color:#7f8c8d;
                   -fx-text-fill:white;
                   -fx-font-size:14px;
                   -fx-background-radius:8;" />

</VBox>
